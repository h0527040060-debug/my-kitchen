# Copy to .env. Never commit real credentials.
DATABASE_URL=postgresql://kitchen:CHANGE_THIS_DATABASE_PASSWORD@db:5432/kitchen
POSTGRES_PASSWORD=CHANGE_THIS_DATABASE_PASSWORD
POSTGRES_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
APP_ORIGIN=http://localhost:3000
PORT=3000
COOKIE_SECURE=false
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
# Optional trusted database CA in PEM format; literal \n sequences are supported.
DATABASE_CA_PEM=
STORAGE_DRIVER=local
MEDIA_ROOT=/app/data/media
UPLOAD_TMP=/app/data/uploads
# For private S3 storage, use STORAGE_DRIVER=s3 and a dedicated private bucket.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OPENAI_API_KEY=
RECIPE_VISION_MODEL=gpt-6.1-sol
RECIPE_VISION_EFFORT=high
RECIPE_ASSISTANT_MODEL=gpt-6.1-sol
RECIPE_ASSISTANT_EFFORT=medium
IMAGE_GENERATION_MODEL=gpt-image-2.5-flare
IMAGE_EDIT_MODEL=gpt-image-2.5-sunburst
IMAGE_QUALITY=medium
IMAGE_EDIT_QUALITY=high
TRANSCRIPTION_MODEL=gpt-transcribe
SPEECH_MODEL=gpt-realtime-2.1-mini
# Set above zero only when ready to authorize API use. This is a request budget, not a dollar cap.
AI_DAILY_MAX_CALLS=0
# Optional operator-verified price table; no cost is displayed if absent or expired.
AI_PRICING_JSON=

# Honor a trusted deployment HTTP(S)_PROXY when configured.
NODE_USE_ENV_PROXY=1
