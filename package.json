{
  "name": "my-kitchen",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --experimental-strip-types --test src/domain.test.ts src/database.test.ts src/local-recipes.test.ts tests/quantities.test.ts tests/cloud.test.ts tests/storage.test.ts",
    "test:ui": "vitest run src/App.test.tsx --environment jsdom --maxWorkers=1",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "dev:server": "node --env-file-if-exists=.env --experimental-strip-types --watch server/index.ts",
    "start": "node --env-file-if-exists=.env --experimental-strip-types server/index.ts",
    "start:cloud": "node --experimental-strip-types server/cloud.ts",
    "worker": "node --env-file-if-exists=.env --experimental-strip-types server/worker.ts",
    "setup": "node --experimental-strip-types scripts/setup-env.ts",
    "migrate": "node --env-file-if-exists=.env --experimental-strip-types scripts/migrate.ts",
    "owner:create": "node --env-file-if-exists=.env --experimental-strip-types scripts/owner.ts",
    "backup": "node --env-file-if-exists=.env --experimental-strip-types scripts/backup.ts backup",
    "restore": "node --env-file-if-exists=.env --experimental-strip-types scripts/backup.ts restore",
    "test:e2e": "playwright test",
    "format": "prettier --write server shared src/kitchen scripts",
    "test:integration": "node --experimental-strip-types --test tests/integration.test.ts && node --experimental-strip-types --test tests/chat-import.integration.test.ts && node --experimental-strip-types --test tests/collection.integration.test.ts",
    "chat:import": "node --experimental-strip-types scripts/chat-import.ts",
    "ai:smoke": "node --env-file-if-exists=.env --experimental-strip-types scripts/ai-smoke.ts",
    "ai:evaluate": "node --experimental-strip-types scripts/evaluate-extraction.ts",
    "owner:reset": "node --env-file-if-exists=.env --experimental-strip-types scripts/owner.ts --reset"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@supabase/supabase-js": "2.118.0",
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "https-proxy-agent": "9.1.0",
    "lucide-react": "1.61.0",
    "multer": "2.5.0",
    "openai": "7.43.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
